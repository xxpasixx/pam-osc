{
  "formatVersion": 1,
  "id": "launchpad-mini-mk3",
  "name": "Novation Launchpad Mini MK3",
  "notes": "Programmer Mode layout (the mode the unit must be switched into for host/DAW LED and note control - hold Session and press the bottom-left pad, or send the Novation Programmer-Mode SysEx; factory default is Live/Session mode and will NOT match this map). No right-hand scene-launch column on this model (unlike the original Launchpad or Launchpad X/Pro) - just the 8x8 grid plus one top row of 8 round function buttons. Grid pads send notes 11-88 (note = 10*row + column, row 1 at the bottom), matching the classic Launchpad numbering. Top row sends CC 91-98 on MIDI channel 1 (Up, Down, Left, Right, Session, Drums, Keys, User). All pads and top-row buttons are RGB and pick their colour from the note/CC velocity-equivalent value (Launchpad colour palette, e.g. 5 = red, 21 = green, 45 = blue) - sending on channel 1 sets solid colour, channel 2 flashes, channel 3 pulses.",
  "manufacturer": "Novation",
  "mode": "standard",
  "defaultMidiChannel": 1,
  "layout": {
    "width": 8,
    "height": 9
  },
